# MongoDB Atlas / local URI, or "memory" for local in-memory demo DB
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?appName=maac
MONGODB_DB=maac

# Admin login (not shown on the public website)
ADMIN_ID=admin
ADMIN_PASSWORD=change-this-password

# Cookie signing secret (min 16 characters)
SESSION_SECRET=replace-with-a-long-random-secret
